generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  prompts   Prompt[]
}

model Prompt {
  id          Int      @id @default(autoincrement())
  userId      Int
  rawPrompt   String
  optimized   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
